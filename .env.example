# =============================================================================
# Database (Docker Compose)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boutique
REDIS_URL=redis://localhost:6379

# =============================================================================
# Meta WhatsApp Cloud API (Graph v23.0)
# Get these from Meta App Dashboard + WhatsApp Manager.
# =============================================================================
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=set-any-random-string-here
META_GRAPH_API_VERSION=v23.0

# Optional aliases also supported by the backend:
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# VERIFY_TOKEN=
# GRAPH_API_VERSION=v23.0

# =============================================================================
# Google Gemini (https://aistudio.google.com/apikey)
# =============================================================================
GEMINI_API_KEY=
# Free tier supports: gemini-2.5-flash, gemini-2.5-flash-lite.
# gemini-2.5-pro requires a paid Google Cloud billing account.
GEMINI_MODEL=gemini-2.5-flash

# Chatbot debug / matching behavior
CHATBOT_DEBUG=true
# Keep false for demo reliability: deterministic perceptual image matching runs first.
# If true, Gemini can be used as a strict high-confidence image-match fallback.
CHATBOT_ENABLE_AI_IMAGE_MATCHING=false
# Minimum image-match confidence (0..1, higher = better) before the bot replies
# to a customer's product photo. Matches below this are silently ignored.
IMAGE_MATCH_MIN_CONFIDENCE=0.78
# When false, an unmatched photo gets NO customer reply (logged + dashboard event
# only). Set true to re-enable the "send a clearer photo / product code" reply.
REPLY_ON_UNMATCHED_IMAGE=false
# Unpaid PENDING orders reserve stock only for this many minutes.
ORDER_RESERVATION_MINUTES=120
# Send one support nudge after this many minutes without customer reply in an active order.
SUPPORT_NUDGE_DELAY_MINUTES=3
# Optional support callback number; falls back to OWNER_WHATSAPP_NUMBER if empty.
SUPPORT_PHONE_NUMBER=

# =============================================================================
# Printing: manual always generates PDFs; printnode also sends to printers.
# =============================================================================
PRINT_PROVIDER=manual
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=
INVOICE_PRINTER_ID=
LABEL_PRINTER_ID=
RECEIPT_PRINTER_ID=
AUTO_PRINT_ON_PAYMENT_APPROVAL=false
AUTO_PRINT_ORDER_LABELS=false
PRINT_AGENT_TOKEN=
PRINT_JOB_MAX_ATTEMPTS=3
PRINT_JOB_CLAIM_TIMEOUT_SECONDS=120

# Windows laptop print bridge only. Do not set printer-specific vars on Render.
BACKEND_URL=http://localhost:3031
DEVICE_ID=kanika-shop-laptop-01
PRINTER_NAME=4BARCODE 4B-2054TG
POLL_INTERVAL_MS=3000
HEARTBEAT_INTERVAL_MS=30000
# LABEL_PROFILE options:
#   4x3_standard         96x68 mm design centered on physical 101.6x76.2 mm stock
PRINT_JOB_BATCH_SIZE=1
LABEL_PROFILE=4x3_standard
# Physical stock (PDF MediaBox / printer paper size).
LABEL_WIDTH_MM=101.6
LABEL_HEIGHT_MM=76.2
PRINT_ORIENTATION=portrait
PRINT_ROTATION=0
PRINT_SCALE_MODE=noscale
PRINT_DRY_RUN=true
OUTPUT_DIR=./print-output

# =============================================================================
# Auth
# Generate SESSION_SECRET with: openssl rand -base64 64
# Set SEED_ADMIN_PASSWORD before running npm run db:seed on a fresh database.
# =============================================================================
SESSION_SECRET=
SESSION_COOKIE_NAME=kda.sid
SESSION_COOKIE_MAX_AGE_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SEED_ADMIN_EMAIL=admin@boutique.local
SEED_ADMIN_PASSWORD=

# =============================================================================
# Business
# =============================================================================
BUSINESS_NAME=Kanika Designs
UPI_ID=kanikadesigns@upi
DEFAULT_SHIPPING_FEE=100

# Owner/admin WhatsApp numbers for payment-approval alerts (E.164 digits, no '+').
# OWNER_WHATSAPP_NUMBER is required to receive alerts; ADMIN_WHATSAPP_NUMBERS is an
# optional comma-separated list of additional recipients.
OWNER_WHATSAPP_NUMBER=
ADMIN_WHATSAPP_NUMBERS=

# =============================================================================
# App
# =============================================================================
NODE_ENV=development
BACKEND_PORT=3031
DASHBOARD_PORT=3030
PUBLIC_BACKEND_URL=http://localhost:3031
PUBLIC_DASHBOARD_URL=http://localhost:3030
NEXT_PUBLIC_BACKEND_URL=http://localhost:3031
# Development convenience only. In production, run the worker as a separate process.
START_EMBEDDED_WORKERS=true
LOG_LEVEL=info
