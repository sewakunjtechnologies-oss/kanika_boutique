# =============================================================================
# Database (Docker Compose)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boutique
REDIS_URL=redis://localhost:6379

# =============================================================================
# Meta WhatsApp Cloud API (Graph v23.0)
# Get these from Meta App Dashboard + WhatsApp Manager.
# =============================================================================
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=set-any-random-string-here
META_GRAPH_API_VERSION=v23.0

# Optional aliases also supported by the backend:
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# VERIFY_TOKEN=
# GRAPH_API_VERSION=v23.0

# =============================================================================
# Google Gemini (https://aistudio.google.com/apikey)
# =============================================================================
GEMINI_API_KEY=
# Free tier supports: gemini-2.5-flash, gemini-2.5-flash-lite.
# gemini-2.5-pro requires a paid Google Cloud billing account.
GEMINI_MODEL=gemini-2.5-flash

# Chatbot debug / matching behavior
CHATBOT_DEBUG=true
# Keep false for demo reliability: deterministic perceptual image matching runs first.
# If true, Gemini can be used as a strict high-confidence image-match fallback.
CHATBOT_ENABLE_AI_IMAGE_MATCHING=false
# Confirm-first: any top distinct product at/above this score is sent to the
# customer as a photo + YES/NO. Below it the bot stays silent. (canonical knob)
IMAGE_MATCH_THRESHOLD=0.50
IMAGE_MIN_SCORE_MARGIN=0.04
IMAGE_NEAR_DUPLICATE_THRESHOLD=0.88
IMAGE_NEAR_DUPLICATE_PHASH_THRESHOLD=0.78
IMAGE_NEAR_DUPLICATE_PIXEL_THRESHOLD=0.82
IMAGE_NEAR_DUPLICATE_EDGE_THRESHOLD=0.82
IMAGE_NEAR_DUPLICATE_FEATURE_THRESHOLD=0.88
IMAGE_LOCAL_FEATURE_THRESHOLD=0.74
IMAGE_LOCAL_FEATURE_MIN_MATCHES=12
IMAGE_LOCAL_FEATURE_MIN_INLIER_RATIO=0.24
IMAGE_LOCAL_FEATURE_MIN_EDGE_SIMILARITY=0.80
IMAGE_LOCAL_FEATURE_MIN_LINE_PATTERN_SIMILARITY=0.90
IMAGE_GARMENT_EMBEDDING_THRESHOLD=0.84
IMAGE_GARMENT_EMBEDDING_MIN_EDGE_SIMILARITY=0.78
IMAGE_GARMENT_EMBEDDING_MIN_LINE_PATTERN_SIMILARITY=0.88
# Gemini "same product?" verifier for non-near-duplicate (fresh studio) photos.
# When on (requires GEMINI_API_KEY), the top-K heuristic candidates are sent to a
# constrained vision check that picks the SAME garment or "none". Off → heuristic only.
IMAGE_VERIFY_WITH_AI=false
IMAGE_VERIFY_TOP_K=3
IMAGE_VERIFY_MIN_CONFIDENCE=0.60
# Non-near-duplicate match when the verifier is off/errors: 'confirm' = one-tap
# customer confirmation gate (safe default); 'silent' = treat as NO MATCH.
IMAGE_UNVERIFIED_NON_NEARDUP_POLICY=confirm
# Garment segmentation (background removal) for the images fed to the verifier, so the
# shared studio backdrop can't collapse different garments. Lazy-loads the native
# @imgly/background-removal-node model only when ON; OFF → original-image behaviour.
# Enabling in production requires `npm install` (pulls onnxruntime-node + ~85MB model).
IMAGE_SEGMENTATION_ENABLED=false
IMAGE_SEGMENTATION_TIMEOUT_MS=4000
IMAGE_SEGMENTATION_CACHE_MAX=256
# Approved policy: unmatched / low-confidence photos receive NO reply (silent no-match).
REPLY_ON_UNMATCHED_IMAGE=false
# Unpaid PENDING orders reserve stock only for this many minutes.
ORDER_RESERVATION_MINUTES=120
# Send one support nudge after this many minutes without customer reply in an active order.
SUPPORT_NUDGE_DELAY_MINUTES=3
# Optional support callback number; falls back to OWNER_WHATSAPP_NUMBER if empty.
SUPPORT_PHONE_NUMBER=

# =============================================================================
# Printing: manual always generates PDFs; printnode also sends to printers.
# =============================================================================
PRINT_PROVIDER=manual
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=
INVOICE_PRINTER_ID=
LABEL_PRINTER_ID=
RECEIPT_PRINTER_ID=
# Auto-print the ORDER_LABEL the moment a payment is approved (no extra click).
# Requires PRINT_AGENT_TOKEN so the Android bridge can claim the job.
AUTO_PRINT_ON_PAYMENT_APPROVAL=true
AUTO_PRINT_ORDER_LABELS=true
PRINT_AGENT_TOKEN=
PRINT_JOB_MAX_ATTEMPTS=3
PRINT_JOB_CLAIM_TIMEOUT_SECONDS=120

# Android phone print bridge settings. Enter these in the Android app; do not set
# printer-specific values on Render except PRINT_AGENT_TOKEN.
BACKEND_URL=http://localhost:3031
DEVICE_ID=kanika-shop-android-01
PRINTER_IP=
PRINTER_PORT=9100
PRINTER_LANGUAGE=TSPL
LABEL_SIZE=4x3
POLL_INTERVAL_SECONDS=3
PRINT_DIRECTION=1

# =============================================================================
# Auth
# Generate SESSION_SECRET with: openssl rand -base64 64
# Set SEED_ADMIN_PASSWORD before running npm run db:seed on a fresh database.
# =============================================================================
SESSION_SECRET=
SESSION_COOKIE_NAME=kda.sid
SESSION_COOKIE_MAX_AGE_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SEED_ADMIN_EMAIL=admin@boutique.local
SEED_ADMIN_PASSWORD=

# =============================================================================
# Business
# =============================================================================
BUSINESS_NAME=Kanika Designs
UPI_ID=kanikadesigns@upi
# Permanent, publicly reachable shop payment QR image (e.g. Cloudinary). Sent as a
# WhatsApp image at checkout instead of the UPI ID. Must be Meta-accessible. No local paths/secrets.
PAYMENT_QR_IMAGE_URL=
DEFAULT_SHIPPING_FEE=100

# Owner/admin WhatsApp numbers for payment-approval alerts (E.164 digits, no '+').
# OWNER_WHATSAPP_NUMBER is required to receive alerts; ADMIN_WHATSAPP_NUMBERS is an
# optional comma-separated list of additional recipients.
OWNER_WHATSAPP_NUMBER=
ADMIN_WHATSAPP_NUMBERS=

# =============================================================================
# App
# =============================================================================
NODE_ENV=development
BACKEND_PORT=3031
DASHBOARD_PORT=3030
PUBLIC_BACKEND_URL=http://localhost:3031
PUBLIC_DASHBOARD_URL=http://localhost:3030
NEXT_PUBLIC_BACKEND_URL=http://localhost:3031
# Development convenience only. In production, run the worker as a separate process.
START_EMBEDDED_WORKERS=true
LOG_LEVEL=info
