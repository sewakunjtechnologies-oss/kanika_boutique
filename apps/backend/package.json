{
  "name": "@kda/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run build --workspace=@kda/db && npm run build --workspace=@kda/shared",
    "dev": "ts-node-dev --respawn --transpile-only --no-notify src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../..",
    "test": "vitest run",
    "sample": "ts-node-dev --transpile-only --no-notify --quiet scripts/sendWebhookSample.ts",
    "send-test": "ts-node-dev --transpile-only --no-notify --quiet scripts/sendTest.ts",
    "testai": "ts-node-dev --transpile-only --no-notify --quiet scripts/testAi.ts",
    "qa:bot": "ts-node-dev --transpile-only --no-notify --quiet scripts/qaSmoke.ts"
  },
  "dependencies": {
    "@google/genai": "^1.5.1",
    "@kda/db": "*",
    "@kda/shared": "*",
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.4",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  }
}
