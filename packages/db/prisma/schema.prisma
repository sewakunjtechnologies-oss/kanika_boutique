// Boutique WhatsApp order system — full schema.
// Every FK is indexed. Fields marked [idx] in the spec have explicit @@index.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum ConversationState {
  IDLE
  AWAITING_PRODUCT_CONFIRMATION
  AWAITING_NEW_PRODUCT
  AWAITING_SIZE
  AWAITING_QTY
  AWAITING_NAME
  AWAITING_ADDRESS
  AWAITING_PINCODE
  AWAITING_PAYMENT
  AWAITING_VERIFICATION
  COMPLETED
  ABANDONED
}

enum Intent {
  ORDER_INTENT
  PERSONAL_CHAT
  UNKNOWN
}

enum OrderStatus {
  PENDING
  PAYMENT_RECEIVED
  PAYMENT_REVIEW
  VERIFIED
  PRINTED
  DISPATCHED
  CANCELLED
  REJECTED
  EXPIRED
}

enum OrderApprovalStatus {
  PENDING_OWNER_APPROVAL
  APPROVED
  REJECTED
}

enum MessageDirection {
  INBOUND
  OUTBOUND_BOT
  OUTBOUND_OWNER_MANUAL
}

enum MessageType {
  TEXT
  IMAGE
  INTERACTIVE_BUTTON
  INTERACTIVE_LIST
  TEMPLATE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  UNKNOWN
}

enum AdminRole {
  OWNER
  MANAGER
  ADMIN
  STAFF
}

enum StockMovementType {
  MANUAL_ADJUSTMENT
  ORDER_DEDUCTION
  MANUAL_RECEIPT_DEDUCTION
  ORDER_CANCELLATION_RELEASE
  CORRECTION
}

enum PaymentMode {
  CASH
  UPI
  CARD
  PAY_LATER
}

enum PrintJobType {
  ORDER_LABEL
  OFFLINE_CUSTOMER_SLIP
  PRODUCT_BARCODE
  TEST_LABEL
}

enum PrintJobStatus {
  PENDING
  CLAIMED
  PRINTING
  PRINTED
  DRY_RUN_COMPLETED
  FAILED
  CANCELLED
}

// =============================================================================
// Catalog
// =============================================================================

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String
  category      String
  categoryId    String?
  basePrice     Decimal  @db.Decimal(10, 2)
  imageUrl      String
  // Cloudinary public_id for the product photo, used to replace/delete the remote asset.
  // Nullable so products created before Cloudinary (or with local images) keep working.
  imagePublicId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryRecord Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]

  @@index([category])
  @@index([categoryId])
  @@index([sku])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  size          String
  color         String?
  stock         Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true)

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  manualReceiptItems ManualReceiptItem[]
  stockMovements     StockMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([isActive])
}

// =============================================================================
// Customers + conversations
// =============================================================================

model Customer {
  id             String   @id @default(cuid())
  whatsappNumber String   @unique
  name           String?
  email          String?
  defaultAddress String?
  defaultCity    String?
  defaultState   String?
  defaultPincode String?
  totalOrders    Int      @default(0)
  totalSpent     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  conversations Conversation[]
  orders        Order[]

  @@index([whatsappNumber])
}

model Conversation {
  id                 String            @id @default(cuid())
  customerId         String
  state              ConversationState @default(IDLE)
  contextJson        Json              @default("{}")
  intent             Intent            @default(UNKNOWN)
  humanTakeover      Boolean           @default(false)
  humanTakeoverUntil DateTime?
  lastInboundAt      DateTime          @default(now())
  lastOutboundAt     DateTime?
  supportNudgeSentAt DateTime?
  supportRequestedAt DateTime?

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([customerId])
  @@index([lastInboundAt])
  @@index([supportNudgeSentAt])
  @@index([supportRequestedAt])
}

// =============================================================================
// Orders
// =============================================================================

model Order {
  id                       String              @id @default(cuid())
  orderNumber              String              @unique
  customerId               String
  status                   OrderStatus         @default(PENDING)
  approvalStatus           OrderApprovalStatus @default(PENDING_OWNER_APPROVAL)
  subtotal                 Decimal             @db.Decimal(12, 2)
  shippingFee              Decimal             @default(0) @db.Decimal(10, 2)
  totalAmount              Decimal             @db.Decimal(12, 2)
  shippingName             String
  shippingAddress          String
  shippingCity             String
  shippingState            String
  shippingPincode          String
  paymentScreenshotUrl     String?
  paymentExtractedAmount   Decimal?            @db.Decimal(12, 2)
  paymentExtractedUtr      String?
  paymentExtractedReceiver String?
  paymentLooksLegitimate   Boolean?
  paymentVerifiedAt        DateTime?
  paymentVerifiedBy        String?
  approvedById             String?
  approvedAt               DateTime?
  rejectedById             String?
  rejectedAt               DateTime?
  rejectionReason          String?
  adminNotifiedAt          DateTime?
  printedAt                DateTime?
  reservationExpiresAt     DateTime?
  notes                    String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  approvedBy     AdminUser?      @relation("OrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy     AdminUser?      @relation("OrderRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  items          OrderItem[]
  stockMovements StockMovement[]
  printJobs      PrintJob[]

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@index([approvalStatus])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([reservationExpiresAt])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productVariantId])
}

// =============================================================================
// Messages — dedup-keyed on whatsappMessageId
// =============================================================================

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  messageType       MessageType
  content           String?
  mediaUrl          String?
  whatsappMessageId String           @unique
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([whatsappMessageId])
  @@index([createdAt])
}

// =============================================================================
// Admin + settings
// =============================================================================

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OWNER)
  createdAt    DateTime  @default(now())

  stockMovements StockMovement[]
  manualReceipts ManualReceipt[]
  approvedOrders Order[]         @relation("OrderApprovedBy")
  rejectedOrders Order[]         @relation("OrderRejectedBy")
}

model AdminSession {
  id        String   @id
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Setting {
  key   String @id
  value String
}

model StockMovement {
  id               String            @id @default(cuid())
  productVariantId String
  type             StockMovementType
  quantityChange   Int
  previousStock    Int
  newStock         Int
  orderId          String?
  manualReceiptId  String?
  adminUserId      String?
  note             String?
  createdAt        DateTime          @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  manualReceipt  ManualReceipt? @relation(fields: [manualReceiptId], references: [id], onDelete: SetNull)
  adminUser      AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([productVariantId])
  @@index([orderId])
  @@index([manualReceiptId])
  @@index([adminUserId])
  @@index([type])
  @@index([createdAt])
}

model ManualReceipt {
  id             String      @id @default(cuid())
  receiptNumber  String      @unique
  customerName   String?
  customerPhone  String?
  subtotal       Decimal     @db.Decimal(12, 2)
  deliveryCharge Decimal     @default(0) @db.Decimal(10, 2)
  discount       Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal     @db.Decimal(12, 2)
  paymentMode    PaymentMode
  notes          String?
  createdById    String
  printedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  createdBy      AdminUser           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items          ManualReceiptItem[]
  stockMovements StockMovement[]

  @@index([receiptNumber])
  @@index([createdById])
  @@index([createdAt])
  @@index([paymentMode])
}

model ManualReceiptItem {
  id               String  @id @default(cuid())
  manualReceiptId  String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)

  manualReceipt ManualReceipt  @relation(fields: [manualReceiptId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([manualReceiptId])
  @@index([productVariantId])
}

// =============================================================================
// Print jobs — claimed and printed by the on-site Windows print bridge.
// A job stays non-PRINTED until the bridge confirms a successful print.
// =============================================================================

model PrintJob {
  id             String         @id @default(uuid())
  orderId        String?
  type           PrintJobType
  status         PrintJobStatus @default(PENDING)
  payload        Json
  idempotencyKey String         @unique
  attempts       Int            @default(0)
  claimedBy      String?
  claimedAt      DateTime?
  printedAt      DateTime?
  lastError      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([orderId])
  @@index([status, createdAt])
  @@index([type])
}
