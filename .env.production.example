# Production environment example. Copy values into your host/provider secret store.

NODE_ENV=production
LOG_LEVEL=info
BACKEND_PORT=3001

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@HOST:6379

PUBLIC_BACKEND_URL=https://api.your-domain.com
PUBLIC_DASHBOARD_URL=https://dashboard.your-domain.com
NEXT_PUBLIC_BACKEND_URL=https://api.your-domain.com

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHATBOT_DEBUG=false
CHATBOT_ENABLE_AI_IMAGE_MATCHING=false
# The bot replies to a product photo ONLY on a confident, unambiguous match.
IMAGE_AUTO_MATCH_THRESHOLD=0.50
# Retained for matcher confidence banding/diagnostics; the bot stays silent below the auto threshold.
IMAGE_CANDIDATE_MATCH_THRESHOLD=0.45
# Best match must beat the second-best distinct product by at least this margin for auto-match.
IMAGE_MIN_SCORE_MARGIN=0.05
# Approved policy: unmatched / low-confidence photos receive NO reply (silent no-match).
REPLY_ON_UNMATCHED_IMAGE=false
ORDER_RESERVATION_MINUTES=120
SUPPORT_NUDGE_DELAY_MINUTES=3
SUPPORT_PHONE_NUMBER=

PRINT_PROVIDER=manual
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=
INVOICE_PRINTER_ID=
LABEL_PRINTER_ID=
RECEIPT_PRINTER_ID=
# Auto-print the ORDER_LABEL the moment a payment is approved (no extra click).
# Requires PRINT_AGENT_TOKEN so the Android bridge can claim the job.
AUTO_PRINT_ON_PAYMENT_APPROVAL=true
AUTO_PRINT_ORDER_LABELS=true
PRINT_AGENT_TOKEN=
PRINT_JOB_MAX_ATTEMPTS=3
PRINT_JOB_CLAIM_TIMEOUT_SECONDS=120

# Android phone print bridge settings. Keep these on the phone app, not Render,
# except PRINT_AGENT_TOKEN which must also be configured on Render.
BACKEND_URL=https://api.your-domain.com
DEVICE_ID=kanika-shop-android-01
PRINTER_IP=
PRINTER_PORT=9100
PRINTER_LANGUAGE=TSPL
LABEL_SIZE=4x3
POLL_INTERVAL_SECONDS=3
PRINT_DIRECTION=1

SESSION_SECRET=
SESSION_COOKIE_NAME=kda.sid
SESSION_COOKIE_MAX_AGE_DAYS=7
SESSION_COOKIE_SECURE=true
# Use none for current Vercel + Render cross-site deployment. Use lax for a shared custom domain setup.
SESSION_COOKIE_SAMESITE=none
# Leave blank for host-only cookies on vercel.app/onrender.com. Use .kanikaboutique.com only if needed for custom subdomains.
SESSION_COOKIE_DOMAIN=
SEED_ADMIN_EMAIL=admin@boutique.local
SEED_ADMIN_PASSWORD=

# Production API should not run workers inside the web process. Start the worker separately.
START_EMBEDDED_WORKERS=false

BUSINESS_NAME=Kanika Designs
UPI_ID=
DEFAULT_SHIPPING_FEE=100

# Owner/admin WhatsApp numbers for instant payment-approval alerts (E.164 digits,
# no '+', e.g. 919876543210). OWNER_WHATSAPP_NUMBER is the primary recipient;
# ADMIN_WHATSAPP_NUMBERS is an optional comma-separated list of extra recipients.
OWNER_WHATSAPP_NUMBER=
ADMIN_WHATSAPP_NUMBERS=
