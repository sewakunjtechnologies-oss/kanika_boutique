# Production environment example. Copy values into your host/provider secret store.

NODE_ENV=production
LOG_LEVEL=info
BACKEND_PORT=3001

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@HOST:6379

PUBLIC_BACKEND_URL=https://api.your-domain.com
PUBLIC_DASHBOARD_URL=https://dashboard.your-domain.com
NEXT_PUBLIC_BACKEND_URL=https://api.your-domain.com

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHATBOT_DEBUG=false
CHATBOT_ENABLE_AI_IMAGE_MATCHING=false
ORDER_RESERVATION_MINUTES=120
SUPPORT_NUDGE_DELAY_MINUTES=3
SUPPORT_PHONE_NUMBER=

PRINT_PROVIDER=manual
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=
INVOICE_PRINTER_ID=
LABEL_PRINTER_ID=
RECEIPT_PRINTER_ID=
AUTO_PRINT_ON_PAYMENT_APPROVAL=false

JWT_SECRET=
SEED_ADMIN_EMAIL=admin@boutique.local
SEED_ADMIN_PASSWORD=
# Leave blank for host-only API cookies. Use .your-domain.com only when backend and dashboard share that parent domain.
COOKIE_DOMAIN=
COOKIE_SECURE=true
# Use none when backend and dashboard are on different site domains, for example Render + Vercel.
COOKIE_SAME_SITE=none

# Production API should not run workers inside the web process. Start the worker separately.
START_EMBEDDED_WORKERS=false

BUSINESS_NAME=Kanika Designs
UPI_ID=
DEFAULT_SHIPPING_FEE=100

# Owner/admin WhatsApp numbers for instant payment-approval alerts (E.164 digits,
# no '+', e.g. 919876543210). OWNER_WHATSAPP_NUMBER is the primary recipient;
# ADMIN_WHATSAPP_NUMBERS is an optional comma-separated list of extra recipients.
OWNER_WHATSAPP_NUMBER=
ADMIN_WHATSAPP_NUMBERS=
